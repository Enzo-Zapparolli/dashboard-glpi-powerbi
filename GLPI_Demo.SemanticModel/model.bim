{
  "name": "GLPI_Demo",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Chamados_GLPI",
        "columns": [
          {
            "name": "ID",
            "dataType": "int64",
            "sourceColumn": "ID",
            "summarizeBy": "none"
          },
          {
            "name": "Data abertura",
            "dataType": "dateTime",
            "sourceColumn": "Data abertura",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "Data fechamento",
            "dataType": "dateTime",
            "sourceColumn": "Data fechamento",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          },
          {
            "name": "Área tratada",
            "dataType": "string",
            "sourceColumn": "Área tratada",
            "summarizeBy": "none"
          },
          {
            "name": "Serviço",
            "dataType": "string",
            "sourceColumn": "Serviço",
            "summarizeBy": "none"
          },
          {
            "name": "Atribuído - Grupo técnico",
            "dataType": "string",
            "sourceColumn": "Atribuído - Grupo técnico",
            "summarizeBy": "none"
          },
          {
            "name": "Mês abertura",
            "dataType": "string",
            "sourceColumn": "Mês abertura",
            "summarizeBy": "none"
          },
          {
            "name": "Tempo atendimento dias",
            "dataType": "double",
            "sourceColumn": "Tempo atendimento dias",
            "summarizeBy": "none"
          },
          {
            "name": "Prioridade",
            "dataType": "string",
            "sourceColumn": "Prioridade",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Total Chamados",
            "expression": "COUNTROWS(Chamados_GLPI)",
            "formatString": "#,0"
          },
          {
            "name": "Chamados Fechados",
            "expression": "CALCULATE([Total Chamados], Chamados_GLPI[Status] = \"Fechado\")",
            "formatString": "#,0"
          },
          {
            "name": "Chamados em Atendimento",
            "expression": "CALCULATE([Total Chamados], Chamados_GLPI[Status] = \"Em atendimento\")",
            "formatString": "#,0"
          },
          {
            "name": "Tempo Médio Atendimento (dias)",
            "expression": "CALCULATE(AVERAGE(Chamados_GLPI[Tempo atendimento dias]), Chamados_GLPI[Status] = \"Fechado\")",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Chamados_GLPI",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Nulos = Table.ReplaceValue(Cabecalhos, \"\", null, Replacer.ReplaceValue, {\"Data fechamento\", \"Tempo atendimento dias\"}),",
                "    Tipos = Table.TransformColumnTypes(Nulos, {{\"ID\", Int64.Type}, {\"Data abertura\", type datetime}, {\"Data fechamento\", type datetime}, {\"Tempo atendimento dias\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      }
    ]
  }
}